{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run dev\" \"npm run mailer\"",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "mailer": "node --experimental-modules server/mailer.js",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && npx netlify deploy --prod --skip-functions-cache"
  },
